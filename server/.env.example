# ============================================
# AIX Nova Bot — Environment Configuration
# ============================================
#
# YOU ONLY NEED TO SET 3 VALUES:
#   1. MONGODB_URI    — from MongoDB Atlas
#   2. OPENAI_API_KEY — from platform.openai.com
#   3. TELEGRAM_BOT_TOKEN — from @BotFather
#
# Everything else is auto-generated with secure defaults.
# If you want fixed credentials (recommended for production),
# uncomment and set the ADMIN_* values below.
#
# To reset auto-generated values, delete the lines or
# set them to empty and they will be regenerated.
#
# Copy this file to .env and fill in your 3 keys:
#   cp .env.example .env
# ============================================

# --- Server ---
PORT=5000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=*

# --- MongoDB (REQUIRED - replace with your Atlas URI) ---
MONGODB_URI=YOUR_MONGODB_URI

# --- OpenAI (REQUIRED - replace with your API key) ---
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# --- Telegram (REQUIRED - replace with your bot token) ---
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# --- JWT (auto-generated with 96-char hex if left empty) ---
# JWT_SECRET=

# --- Admin credentials (auto-generated if left empty) ---
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# ADMIN_EMAIL=
