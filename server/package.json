{
  "name": "aix-nova-bot",
  "version": "1.0.0",
  "description": "AIX Nova - Production-ready AI Telegram Bot powered by OpenAI",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "pm2": "pm2 start server.js --name aix-nova",
    "pm2:stop": "pm2 stop aix-nova",
    "pm2:restart": "pm2 restart aix-nova",
    "pm2:logs": "pm2 logs aix-nova",
    "seed:admin": "node scripts/seedAdmin.js"
  },
  "keywords": ["telegram", "bot", "ai", "openai", "chatgpt", "express", "mongodb"],
  "author": "AIX Nova",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "morgan": "^1.10.0",
    "node-telegram-bot-api": "^0.66.0",
    "openai": "^4.52.3",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
